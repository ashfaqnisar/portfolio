{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [".next/**", "node_modules/**", "bun.lock"],
  "indentStyle": "space",
  "indentWidth": 2,
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "sortImports": {
    "customGroups": [
      {
        "groupName": "app-alias",
        "elementNamePattern": ["@/**"],
        "modifiers": ["value"]
      }
    ],
    "groups": [
      "value-builtin",
      "value-external",
      "app-alias",
      ["value-parent", "value-sibling", "value-index"],
      [
        "type-builtin",
        "type-external",
        "type-import",
        "type-internal",
        "type-subpath",
        "type-parent",
        "type-sibling",
        "type-index"
      ],
      "unknown"
    ]
  }
}
